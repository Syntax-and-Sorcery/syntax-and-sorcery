# Copy to .env.local. Set NEXT_PUBLIC_DATA_SOURCE=mock and CODE_RUNNER=local for local dev.

# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DATA_SOURCE=              # mock | supabase

# Server only
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
CODE_RUNNER=                          # local | sandbox
DAILY_AI_LIMIT=
DAILY_SANDBOX_LIMIT=
AI_DOWN=                              # set to 1 to force every AI call to fail
